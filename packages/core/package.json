{
  "name": "@readly/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared GitHub-flavored Markdown renderer for readly (CLI and web).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./katex.css": "./dist/katex.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "github-markdown-css": "^5.9.0",
    "mermaid": "^12.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0"
  }
}
