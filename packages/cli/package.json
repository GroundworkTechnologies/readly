{
  "name": "@groundworktechnologies/readly",
  "version": "0.1.0",
  "description": "Render Markdown exactly like GitHub does, locally, without pushing. Live reload included.",
  "keywords": [
    "markdown",
    "readme",
    "github",
    "preview",
    "mermaid",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroundworkTechnologies/readly.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/GroundworkTechnologies/readly#readme",
  "bugs": {
    "url": "https://github.com/GroundworkTechnologies/readly/issues"
  },
  "type": "module",
  "bin": {
    "readly": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm --prefix ../.. run build:cli"
  },
  "devDependencies": {
    "@readly/core": "*",
    "@types/express": "^5.0.6"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "express": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
